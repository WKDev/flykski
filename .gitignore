# 시크릿 — 절대 커밋 금지 (neuprint 토큰)
.env
.Renviron

# 로컬 에이전트/IDE 설정
.claude/
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# flybody 대용량 데이터(체크포인트/데이터셋) — 필요 시 figshare에서 수동 다운로드
flybody-data/

# R
.Rhistory
.RData

# RL 학습 산출물 중 큰 파일(롤아웃 GIF ~20MB, 로그)은 로컬에만 둔다.
runs/*/*.gif
runs/*.log

# RL 시범 데이터(수십 MB)와 임시 실험 스크립트는 로컬에만.
runs/*/bc_data.npz
.scratch/
